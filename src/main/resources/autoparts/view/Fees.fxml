<?xml version="1.0" encoding="UTF-8"?>



<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.FeesController" spacing="16">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Tarifas" styleClass="page-title"/>
        <Label text="Valor de cada servicio de los talleres y desde qué fecha rige." styleClass="secondary-text"/>
    </VBox>

    <!-- Barra de búsqueda y filtro -->
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Buscar por servicio..." onAction="#search"
                   HBox.hgrow="ALWAYS" maxWidth="420"/>
        <Button text="Buscar" onAction="#search" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Estado:" styleClass="field-label"/>
        <ComboBox fx:id="cmbFilter" onAction="#search" prefWidth="160"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tblFees" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colService" text="Servicio" prefWidth="280"/>
            <TableColumn fx:id="colAmount" text="Valor" prefWidth="160"/>
            <TableColumn fx:id="colStartDate" text="Vigente desde" prefWidth="160"/>
            <TableColumn fx:id="colStatus" text="Estado" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Mensajes: cantidad de resultados o errores -->
    <Label fx:id="lblMessage" styleClass="secondary-text"/>
</VBox>
