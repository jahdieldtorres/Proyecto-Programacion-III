<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Detalle de un repuesto: datos a la izquierda y comparación entre almacenes a la derecha -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.ComponentDetailController" spacing="16">

    <Button text="← Volver al catálogo" onAction="#back" styleClass="link-button"/>

    <HBox spacing="24" VBox.vgrow="ALWAYS">
        <!-- Datos del repuesto -->
        <VBox spacing="8" prefWidth="380" minWidth="340" styleClass="card">
            <padding><Insets top="16" right="16" bottom="20" left="16"/></padding>
            <StackPane prefHeight="250" minHeight="250" styleClass="product-photo">
                <ImageView fx:id="imgPhoto" fitWidth="346" fitHeight="250" preserveRatio="true"/>
                <Label fx:id="lblNoPhoto" text="Sin foto" styleClass="secondary-text"/>
            </StackPane>
            <Label fx:id="lblBrand" styleClass="product-brand"/>
            <Label fx:id="lblName" styleClass="section-title" wrapText="true"/>
            <Label fx:id="lblReference" styleClass="reference-chip"/>
            <Label fx:id="lblCompatibility"/>
            <Region prefHeight="4"/>
            <Label fx:id="lblCategory" styleClass="secondary-text"/>
            <Label fx:id="lblOrigin" styleClass="secondary-text"/>
        </VBox>

        <!-- Ofertas de los almacenes -->
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Ofertas de los almacenes" styleClass="page-title"/>
                    <Label fx:id="lblSummary" styleClass="secondary-text" wrapText="true"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Ordenar por" styleClass="field-label"/>
                <ComboBox fx:id="cmbCriterion" onAction="#loadOffers"/>
            </HBox>

            <Label fx:id="lblMessage" wrapText="true"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="clear-scroll">
                <VBox fx:id="offersBox" spacing="12">
                    <padding><Insets top="2" right="4" bottom="12" left="2"/></padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
