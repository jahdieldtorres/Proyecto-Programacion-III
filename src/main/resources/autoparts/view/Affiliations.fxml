<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pantalla de afiliaciones (proveedor afiliado a un taller).
    Copiada de ListTemplate.fxml: solo cambian los textos, las columnas y el controlador.
    Sin estilos en línea: todos los estilos están en styles.css.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.AffiliationsController" spacing="16">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Afiliaciones" styleClass="page-title"/>
        <Label text="Proveedores afiliados a cada taller y desde qué fecha." styleClass="secondary-text"/>
    </VBox>

    <!-- Barra de búsqueda y filtro -->
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Buscar por proveedor o taller..." onAction="#search"
                   HBox.hgrow="ALWAYS" maxWidth="420"/>
        <Button text="Buscar" onAction="#search" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Estado:" styleClass="field-label"/>
        <ComboBox fx:id="cmbFilter" onAction="#search" prefWidth="160"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tblAffiliations" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSupplier" text="Proveedor" prefWidth="280"/>
            <TableColumn fx:id="colWorkshop" text="Taller" prefWidth="280"/>
            <TableColumn fx:id="colStartDate" text="Fecha de inicio" prefWidth="140"/>
            <TableColumn fx:id="colStatus" text="Estado" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Mensajes: cantidad de resultados o errores -->
    <Label fx:id="lblMessage" styleClass="secondary-text"/>
</VBox>