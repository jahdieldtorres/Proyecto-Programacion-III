<?xml version="1.0" encoding="UTF-8"?>

<!-- Pantalla del catálogo de componentes. Hecha a partir de ListTemplate.fxml. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.CatalogController" spacing="16">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Catálogo de componentes" styleClass="page-title"/>
        <Label text="Busca un repuesto por nombre o referencia y filtra por categoría." styleClass="secondary-text"/>
    </VBox>

    <!-- Barra de búsqueda y filtro -->
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Buscar por nombre o referencia..." onAction="#search"
                   HBox.hgrow="ALWAYS" maxWidth="420"/>
        <Button text="Buscar" onAction="#search" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Categoría:" styleClass="field-label"/>
        <ComboBox fx:id="cmbCategory" onAction="#search" prefWidth="180"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tblComponents" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Nombre" prefWidth="260"/>
            <TableColumn fx:id="colReference" text="Referencia" prefWidth="130"/>
            <TableColumn fx:id="colType" text="Tipo" prefWidth="110"/>
            <TableColumn fx:id="colBrand" text="Marca" prefWidth="120"/>
            <TableColumn fx:id="colCategory" text="Categoría" prefWidth="140"/>
            <TableColumn fx:id="colOrigin" text="Procedencia" prefWidth="110"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Mensajes: cantidad de resultados o errores -->
    <Label fx:id="lblMessage" styleClass="secondary-text"/>
</VBox>
