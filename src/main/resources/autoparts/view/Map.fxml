<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<!-- Talleres cerca: lista ordenada por distancia a la izquierda y mapa real a la derecha -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.MapController" spacing="20">

    <!-- Lista -->
    <VBox spacing="12" prefWidth="370" minWidth="340">
        <VBox spacing="2">
            <Label text="Almacenes y talleres cerca" styleClass="page-title"/>
            <Label fx:id="lblFrom" styleClass="secondary-text" wrapText="true"/>
        </VBox>
        <Button text="Cambiar mi ubicación" onAction="#askLocation" styleClass="secondary-button"/>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="clear-scroll">
            <VBox fx:id="listBox" spacing="10">
                <padding><Insets top="2" right="6" bottom="12" left="2"/></padding>
            </VBox>
        </ScrollPane>
        <Label fx:id="lblMessage" styleClass="error-message" wrapText="true"/>
    </VBox>

    <!-- Mapa con sus capas: el mapa, la pantalla de carga y la ventanita de ubicación -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="map-box">
        <WebView fx:id="webView"/>

        <VBox fx:id="loadingBox" alignment="CENTER" spacing="14" styleClass="map-overlay">
            <Label fx:id="lblLoading" text="Cargando mapa de Valledupar…" styleClass="section-title"/>
            <ProgressBar fx:id="progressBar" prefWidth="280"/>
        </VBox>

        <VBox fx:id="locationBox" alignment="CENTER" visible="false" styleClass="map-overlay-dim">
            <VBox spacing="12" maxWidth="400" maxHeight="-Infinity" styleClass="card">
                <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
                <Label text="¿Desde dónde buscas?" styleClass="section-title"/>
                <Label text="Usaremos tu ubicación para ordenar los almacenes y talleres por cercanía. Se guarda en este computador para tu cuenta."
                       wrapText="true" styleClass="secondary-text"/>
                <Button text="Elegir en el mapa" onAction="#pickOnMap" maxWidth="Infinity" styleClass="primary-button"/>
                <Button text="Usar la Universidad Popular del Cesar" onAction="#useDefaultLocation"
                        maxWidth="Infinity" styleClass="secondary-button"/>
            </VBox>
        </VBox>

        <Label fx:id="lblPickHint" text="Haz clic en el mapa donde estás" visible="false"
               StackPane.alignment="TOP_CENTER" styleClass="map-hint">
            <StackPane.margin><Insets top="14"/></StackPane.margin>
        </Label>
    </StackPane>
</HBox>
