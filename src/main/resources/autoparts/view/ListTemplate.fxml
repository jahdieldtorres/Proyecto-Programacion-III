<?xml version="1.0" encoding="UTF-8"?>

<!--
    PLANTILLA DE PANTALLA DE LISTADO
    Copien este archivo para su pantalla (por ejemplo Catalog.fxml) y cambien:
      1. fx:controller por su controlador (autoparts.view.CatalogController).
      2. El título y el subtítulo.
      3. Las columnas de la tabla (fx:id y text).
    No agreguen style="..." aquí: todos los estilos están en styles.css.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.ListTemplateController" spacing="16">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Título de la pantalla" styleClass="page-title"/>
        <Label text="Una línea que explica qué se ve en esta pantalla." styleClass="secondary-text"/>
    </VBox>

    <!-- Barra de búsqueda y filtro -->
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Buscar por nombre..." onAction="#search"
                   HBox.hgrow="ALWAYS" maxWidth="420"/>
        <Button text="Buscar" onAction="#search" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Filtrar:" styleClass="field-label"/>
        <ComboBox fx:id="cmbFilter" onAction="#search" prefWidth="160"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tblItems" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Nombre" prefWidth="280"/>
            <TableColumn fx:id="colDetail" text="Detalle" prefWidth="240"/>
            <TableColumn fx:id="colPrice" text="Precio" prefWidth="140"/>
            <TableColumn fx:id="colStatus" text="Estado" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Mensajes: errores o "sin resultados" -->
    <Label fx:id="lblMessage" styleClass="secondary-text"/>
</VBox>
