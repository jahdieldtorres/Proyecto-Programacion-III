<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<!-- Servicios de talleres: cada taller aliado con sus servicios y la tarifa vigente -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="autoparts.view.ServicesController" fitToWidth="true" styleClass="clear-scroll">
    <VBox spacing="18">
        <VBox spacing="2">
            <Label text="Servicios de talleres" styleClass="page-title"/>
            <Label text="Instalación y mantenimiento con talleres aliados de Valledupar." styleClass="secondary-text"/>
        </VBox>

        <Label text="Talleres aliados y sus servicios" styleClass="section-title"/>
        <FlowPane fx:id="workshopsBox" hgap="16" vgap="16"/>
        <Label fx:id="lblMessage" styleClass="error-message" wrapText="true"/>

        <VBox spacing="10" styleClass="card" maxWidth="620">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
            <Label text="Así va a funcionar" styleClass="field-label"/>
            <Label text="1. Eliges el servicio y ves la tarifa del taller." wrapText="true"/>
            <Label text="2. Escoges el taller más cercano en el mapa." wrapText="true"/>
            <Label text="3. Agendas la cita desde la app y la ves en Mis citas; también puedes escribirle por WhatsApp." wrapText="true"/>
        </VBox>
    </VBox>
</ScrollPane>
