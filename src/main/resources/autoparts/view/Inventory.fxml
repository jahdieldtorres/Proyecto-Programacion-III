<?xml version="1.0" encoding="UTF-8"?>

<!-- Pantalla del inventario de los proveedores (solo administrador). Hecha a partir de ListTemplate.fxml. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.InventoryController" spacing="16">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Inventario" styleClass="page-title"/>
        <Label text="Ofertas de los proveedores: precio, stock, envío, garantía y condición de cada componente." styleClass="secondary-text"/>
    </VBox>

    <!-- Barra de búsqueda, filtro y botones de gestión -->
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Buscar por componente..." onAction="#load"
                   HBox.hgrow="ALWAYS" maxWidth="420"/>
        <Button text="Buscar" onAction="#load" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Proveedor:" styleClass="field-label"/>
        <ComboBox fx:id="cmbSupplier" onAction="#load" prefWidth="200"/>
        <!-- Nuevo, Editar y Desactivar: solo los ve el administrador -->
        <Button fx:id="btnNew" text="Nuevo" onAction="#newItem" styleClass="primary-button"/>
        <Button fx:id="btnEdit" text="Editar" onAction="#editItem" styleClass="secondary-button"/>
        <Button fx:id="btnDeactivate" text="Desactivar" onAction="#deactivateItem" styleClass="secondary-button"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tblInventory" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSupplier" text="Proveedor" prefWidth="170"/>
            <TableColumn fx:id="colComponent" text="Componente" prefWidth="240"/>
            <TableColumn fx:id="colPrice" text="Precio" prefWidth="110"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="70"/>
            <TableColumn fx:id="colShipping" text="Envío" prefWidth="100"/>
            <TableColumn fx:id="colWarranty" text="Garantía" prefWidth="90"/>
            <TableColumn fx:id="colCondition" text="Condición" prefWidth="130"/>
            <TableColumn fx:id="colStatus" text="Estado" prefWidth="90"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Cantidad de ofertas y mensajes de error -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="lblCount" styleClass="secondary-text"/>
        <Label fx:id="lblMessage" styleClass="error-message" wrapText="true"/>
    </HBox>
</VBox>