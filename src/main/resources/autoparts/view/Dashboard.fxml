<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="autoparts.view.DashboardController" styleClass="app-background">

    <!-- Menú lateral: los botones que el rol no puede usar se ocultan en DashboardController -->
    <left>
        <VBox spacing="4" prefWidth="230" styleClass="sidebar">
            <padding><Insets top="24" right="14" bottom="20" left="14"/></padding>
            <Label text="ORIGEN" styleClass="sidebar-logo"/>
            <Label text="Portal de Repuestos" styleClass="sidebar-subtitle"/>
            <Region prefHeight="14"/>

            <Button fx:id="btnHome" text="Inicio" onAction="#goToHome" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnCatalog" text="Catálogo" onAction="#goToCatalog" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnComparator" text="Comparador" onAction="#goToComparator" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnVehicles" text="Vehículos" onAction="#goToVehicles" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnPartners" text="Socios" onAction="#goToPartners" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnInventory" text="Inventario" onAction="#goToInventory" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnFees" text="Tarifas" onAction="#goToFees" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnAffiliations" text="Afiliaciones" onAction="#goToAffiliations" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnUsers" text="Usuarios" onAction="#goToUsers" styleClass="menu-button" maxWidth="Infinity"/>
            <Button fx:id="btnMyAccount" text="Mi cuenta" onAction="#goToMyAccount" styleClass="menu-button" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator styleClass="menu-separator"/>
            <Label fx:id="lblUser" styleClass="sidebar-user" wrapText="true"/>
            <Label fx:id="lblRole" styleClass="sidebar-subtitle"/>
            <Button text="Cerrar sesión" onAction="#logout" styleClass="menu-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Contenido: aquí se cargan las vistas de cada módulo -->
    <center>
        <StackPane fx:id="content">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
        </StackPane>
    </center>
</BorderPane>
