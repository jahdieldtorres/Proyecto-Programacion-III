<?xml version="1.0" encoding="UTF-8"?>

<!--
    Formulario para crear o editar una oferta del inventario.
    Copia de FormTemplate.fxml: título, campos, lblMessage, Guardar y Cancelar.
    Sin estilos en línea: todos los estilos están en styles.css.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.InventoryFormController" spacing="14" prefWidth="460"
      styleClass="app-background">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- Título -->
    <Label fx:id="lblTitle" text="Nueva oferta" styleClass="page-title"/>

    <!-- Proveedor y componente -->
    <VBox spacing="4">
        <Label text="Proveedor" styleClass="field-label"/>
        <ComboBox fx:id="cmbSupplier" maxWidth="Infinity" promptText="Elige un proveedor"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Componente" styleClass="field-label"/>
        <ComboBox fx:id="cmbComponent" maxWidth="Infinity" promptText="Elige un componente"/>
    </VBox>

    <!-- Precio y stock -->
    <VBox spacing="4">
        <Label text="Precio (pesos)" styleClass="field-label"/>
        <TextField fx:id="txtPrice" promptText="Ej.: 185000"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Stock (unidades)" styleClass="field-label"/>
        <TextField fx:id="txtStock" promptText="Ej.: 8"/>
    </VBox>

    <!-- Envío y garantía -->
    <VBox spacing="4">
        <Label text="Costo de envío (pesos)" styleClass="field-label"/>
        <TextField fx:id="txtShipping" promptText="Ej.: 12000"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Garantía (meses)" styleClass="field-label"/>
        <TextField fx:id="txtWarranty" promptText="Ej.: 12"/>
    </VBox>

    <!-- Condición y estado -->
    <VBox spacing="4">
        <Label text="Condición" styleClass="field-label"/>
        <ComboBox fx:id="cmbCondition" maxWidth="Infinity"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Estado" styleClass="field-label"/>
        <ComboBox fx:id="cmbStatus" maxWidth="Infinity"/>
    </VBox>

    <!-- Descripción y foto de la oferta -->
    <VBox spacing="4">
        <Label text="Descripción (opcional, máximo 500 caracteres)" styleClass="field-label"/>
        <TextArea fx:id="txtDescription" prefRowCount="3" wrapText="true"
                  promptText="Ej.: Producto nuevo en su caja original. Retiro en tienda o envío."/>
    </VBox>
    <VBox spacing="4">
        <Label text="Foto de la oferta (opcional)" styleClass="field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Elegir foto" onAction="#choosePhoto" styleClass="secondary-button"/>
            <Label fx:id="lblPhoto" text="Sin foto" styleClass="secondary-text" wrapText="true"/>
        </HBox>
    </VBox>

    <!-- Mensaje de error -->
    <Label fx:id="lblMessage" styleClass="error-message" wrapText="true"/>

    <!-- Botones -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" onAction="#cancel" styleClass="secondary-button"/>
        <Button fx:id="btnSave" text="Guardar" onAction="#save" styleClass="primary-button"/>
    </HBox>
</VBox>