<?xml version="1.0" encoding="UTF-8"?>

<!-- Pantalla de usuarios (solo ADMIN). Hecha a partir de ListTemplate.fxml. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.UsersController" spacing="16">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Usuarios" styleClass="page-title"/>
        <Label text="Gestiona los roles y el estado de las cuentas." styleClass="secondary-text"/>
    </VBox>

    <!-- Búsqueda y filtro -->
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Buscar por nombre o correo..." onAction="#search"
                   HBox.hgrow="ALWAYS" maxWidth="420"/>
        <Button text="Buscar" onAction="#search" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Rol:" styleClass="field-label"/>
        <ComboBox fx:id="cmbFilter" onAction="#search" prefWidth="160"/>
    </HBox>

    <!-- Tabla -->
    <TableView fx:id="tblUsers" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="colEmail" text="Correo" prefWidth="240"/>
            <TableColumn fx:id="colRole" text="Rol" prefWidth="110"/>
            <TableColumn fx:id="colStatus" text="Estado" prefWidth="110"/>
            <TableColumn fx:id="colSince" text="Registro" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Acciones sobre el usuario seleccionado -->
    <HBox spacing="10" styleClass="toolbar">
        <Label text="Nuevo rol:" styleClass="field-label"/>
        <ComboBox fx:id="cmbRole" prefWidth="160"/>
        <Button text="Asignar rol" onAction="#assignRole" styleClass="secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Activar / desactivar" onAction="#toggleStatus" styleClass="secondary-button"/>
    </HBox>

    <!-- Mensajes -->
    <Label fx:id="lblMessage" styleClass="secondary-text" wrapText="true"/>
</VBox>
