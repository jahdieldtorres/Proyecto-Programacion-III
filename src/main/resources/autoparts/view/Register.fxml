<?xml version="1.0" encoding="UTF-8"?>

<?import autoparts.view.LogoTree?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Mismo diseño del inicio de sesión: logo a la izquierda y formulario a la derecha -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.RegisterController" styleClass="login-root">

    <StackPane prefWidth="440" minWidth="400" styleClass="login-side">
        <VBox alignment="CENTER" spacing="8">
            <LogoTree/>
            <Label text="ORIGEN" styleClass="login-brand"/>
            <Label text="Crea tu cuenta y compara precios en toda la ciudad" styleClass="login-tagline"
                   wrapText="true" maxWidth="320"/>
        </VBox>
    </StackPane>

    <StackPane HBox.hgrow="ALWAYS" styleClass="login-form-side">
        <padding><Insets top="30" right="48" bottom="30" left="48"/></padding>
        <VBox spacing="9" maxWidth="360" maxHeight="-Infinity">
            <Label text="Crear cuenta" styleClass="card-title"/>
            <Label text="Regístrate para comparar y comprar repuestos." styleClass="secondary-text"/>

            <Label text="Nombre completo" styleClass="field-label">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
            <TextField fx:id="txtName" promptText="Nombre y apellido"/>
            <Label text="Correo" styleClass="field-label"/>
            <TextField fx:id="txtEmail" promptText="tucorreo@ejemplo.com"/>
            <Label text="Contraseña" styleClass="field-label"/>
            <PasswordField fx:id="txtPassword" promptText="Mínimo 8 caracteres"/>
            <Label text="Confirmar contraseña" styleClass="field-label"/>
            <PasswordField fx:id="txtConfirmation" promptText="Repite la contraseña" onAction="#register"/>

            <Label fx:id="lblMessage" styleClass="error-message" wrapText="true"/>
            <Label fx:id="lblSuccess" styleClass="success-message" wrapText="true"/>

            <Button text="Crear cuenta" onAction="#register" defaultButton="true"
                    maxWidth="Infinity" styleClass="primary-button"/>
            <HBox alignment="CENTER" spacing="4">
                <Label text="¿Ya tienes cuenta?" styleClass="secondary-text"/>
                <Hyperlink text="Inicia sesión" onAction="#backToLogin"/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
