<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="autoparts.view.RegisterController" styleClass="login-background">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <VBox spacing="12" maxWidth="420" maxHeight="-Infinity" styleClass="card">
        <padding><Insets top="32" right="36" bottom="32" left="36"/></padding>
        <Label text="Crear cuenta" styleClass="card-title"/>
        <Label text="Regístrate para comparar y comprar repuestos" styleClass="secondary-text"/>
        <Region prefHeight="4"/>

        <Label text="Nombre completo" styleClass="field-label"/>
        <TextField fx:id="txtName" promptText="Nombre y apellido"/>

        <Label text="Correo" styleClass="field-label"/>
        <TextField fx:id="txtEmail" promptText="tucorreo@ejemplo.com"/>

        <Label text="Contraseña" styleClass="field-label"/>
        <PasswordField fx:id="txtPassword" promptText="Mínimo 8 caracteres"/>

        <Label text="Confirmar contraseña" styleClass="field-label"/>
        <PasswordField fx:id="txtConfirmation" promptText="Repite la contraseña" onAction="#register"/>

        <Label fx:id="lblMessage" styleClass="error-message" wrapText="true"/>
        <Label fx:id="lblSuccess" styleClass="success-message" wrapText="true"/>

        <Button text="Crear cuenta" onAction="#register" defaultButton="true"
                maxWidth="Infinity" styleClass="primary-button"/>
        <Button text="Volver a iniciar sesión" onAction="#backToLogin"
                maxWidth="Infinity" styleClass="secondary-button"/>
    </VBox>
</StackPane>
