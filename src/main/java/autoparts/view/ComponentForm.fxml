<?xml version="1.0" encoding="UTF-8"?>

<!--
    Formulario para crear o editar un componente.
    Copia de FormTemplate.fxml: título, campos, lblMessage, Guardar y Cancelar.
    Sin estilos en línea: todos los estilos están en styles.css.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.ComponentFormController" spacing="14" prefWidth="460"
      styleClass="app-background">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- Título: el controlador lo cambia a "Nuevo componente" o "Editar componente" -->
    <Label fx:id="lblTitle" text="Nuevo componente" styleClass="page-title"/>

    <!-- Campos -->
    <VBox spacing="4">
        <Label text="Nombre" styleClass="field-label"/>
        <TextField fx:id="txtName" promptText="Ej.: Filtro de aceite"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Referencia" styleClass="field-label"/>
        <TextField fx:id="txtReference" promptText="Ej.: FO-3301"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Marca" styleClass="field-label"/>
        <ComboBox fx:id="cmbBrand" maxWidth="Infinity" promptText="Elige una marca"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Categoría" styleClass="field-label"/>
        <ComboBox fx:id="cmbCategory" maxWidth="Infinity" promptText="Elige una categoría"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Origen" styleClass="field-label"/>
        <ComboBox fx:id="cmbOrigin" maxWidth="Infinity"/>
    </VBox>

    <!-- Mensaje de error -->
    <Label fx:id="lblMessage" styleClass="error-message" wrapText="true"/>

    <!-- Botones -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" onAction="#cancel" styleClass="secondary-button"/>
        <Button fx:id="btnSave" text="Guardar" onAction="#save" styleClass="primary-button"/>
    </HBox>
</VBox>
