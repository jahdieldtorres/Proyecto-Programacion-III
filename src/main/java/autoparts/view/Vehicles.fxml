<?xml version="1.0" encoding="UTF-8"?>

<!--
    Pantalla de vehículos (solo consulta). Hecha a partir de ListTemplate.fxml:
    arriba la tabla de vehículos y abajo los repuestos compatibles con el
    vehículo elegido. Sin estilos en línea: todos los estilos están en styles.css.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="autoparts.view.VehiclesController" spacing="16">

    <!-- Encabezado -->
    <VBox spacing="4">
        <Label text="Vehículos" styleClass="page-title"/>
        <Label text="Elige un vehículo para ver los repuestos compatibles." styleClass="secondary-text"/>
    </VBox>

    <!-- Barra de búsqueda -->
    <HBox spacing="10" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Buscar por marca o modelo..." onAction="#search"
                   HBox.hgrow="ALWAYS" maxWidth="420"/>
        <Button text="Buscar" onAction="#search" styleClass="primary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Tabla de vehículos -->
    <TableView fx:id="tblVehicles" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colType" text="Tipo" prefWidth="110"/>
            <TableColumn fx:id="colBrand" text="Marca" prefWidth="150"/>
            <TableColumn fx:id="colModel" text="Modelo" prefWidth="170"/>
            <TableColumn fx:id="colYear" text="Año" prefWidth="80"/>
            <TableColumn fx:id="colDetail" text="Detalle" prefWidth="200"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Repuestos compatibles con el vehículo elegido -->
    <Label fx:id="lblCompatible" text="Repuestos compatibles" styleClass="field-label"/>
    <TableView fx:id="tblComponents" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colComponentName" text="Nombre" prefWidth="260"/>
            <TableColumn fx:id="colComponentReference" text="Referencia" prefWidth="130"/>
            <TableColumn fx:id="colComponentType" text="Tipo" prefWidth="110"/>
            <TableColumn fx:id="colComponentBrand" text="Marca" prefWidth="120"/>
            <TableColumn fx:id="colComponentCategory" text="Categoría" prefWidth="140"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <!-- Mensajes: cantidad de resultados o errores -->
    <Label fx:id="lblMessage" styleClass="secondary-text"/>
</VBox>
